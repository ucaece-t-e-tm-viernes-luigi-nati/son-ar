# Copiá este archivo como .env.local y completá los valores. NUNCA subas .env.local a git.

# Conexión a Neon (Neon → tu proyecto → Connect → copiar la connection string).
DATABASE_URL="postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Clave para firmar sesiones. Generala con:  npx @better-auth/cli secret
BETTER_AUTH_SECRET=""

# En tu PC dejalo así. En Vercel no hace falta: se calcula solo.
BETTER_AUTH_URL="http://localhost:3000"
