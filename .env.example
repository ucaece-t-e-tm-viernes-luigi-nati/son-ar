# Copiá este archivo como .env.local y completá los valores. NUNCA subas .env.local a git (el repo es público).
# En Vercel: Settings → Environment Variables (las mismas claves).

# --- Base de datos (Neon) ---
# Neon → tu proyecto → Connect → copiar la connection string.
DATABASE_URL="postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# --- Sesiones (better-auth) ---
# Generala con:  npx @better-auth/cli secret   (o cualquier string aleatorio de 32+ caracteres)
BETTER_AUTH_SECRET=""
# En tu PC: http://localhost:3000. En Vercel se puede dejar vacía (se calcula sola) o poner la URL de producción.
BETTER_AUTH_URL="http://localhost:3000"
# URL pública que va en los links de los mails (ej. https://son-ar.vercel.app).
APP_URL="http://localhost:3000"

# --- Superadmin (equipo de Son.ar) ---
# Emails habilitados como superadmin, separados por coma. Entran por la URL interna de la plataforma
# ("Primer ingreso" les manda un link de un solo uso para definir la contraseña). Nunca se hardcodean en el código.
SUPERADMIN_EMAILS="equipo@ejemplo.com"
# Quiénes reciben el aviso de "Nueva solicitud de alta" (si se deja vacío, se usa SUPERADMIN_EMAILS).
SUPERADMIN_NOTIFY_EMAILS=""

# --- Mails ---
# smtp = envío real con Gmail / Google Workspace (contraseña de aplicación) vía nodemailer.
# Cualquier otro valor (o vacío) = los mails solo se guardan en email_outbox (visibles en la plataforma → Mails).
MAIL_PROVIDER="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="equipo@ejemplo.com"
# Contraseña de APLICACIÓN de Google (16 caracteres), no la contraseña normal de la cuenta.
SMTP_PASS=""
MAIL_FROM="Son.ar <equipo@ejemplo.com>"

# --- Cron de vencimientos ---
# Vercel la manda como "Authorization: Bearer <CRON_SECRET>" al llamar /api/cron/vencimientos.
CRON_SECRET=""
# Días de gracia entre el vencimiento y la pausa automática (opcional, default 7).
PAUSE_AFTER_DAYS="7"

# --- Datos de demo ---
# true = en cada build carga perfiles, posts, convocatorias y conexiones de ejemplo, 3 venues aprobados
# y actividad de los últimos 60 días para el dashboard (idempotente).
SEED_DEMO="true"
# Opcional: si se completa (8+ caracteres), el seed crea usuarios demo (…demo@example.com) con esta contraseña.
# Si queda vacía, los perfiles demo existen pero nadie puede ingresar con ellos.
SEED_DEMO_PASSWORD=""

# --- Contacto comercial (botón "Tengo un venue" de la landing) ---
# Si hay email se usa mailto:, si no, WhatsApp. Son públicos (se ven en el navegador).
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_WHATSAPP=""
